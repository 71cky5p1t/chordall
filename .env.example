# Copy to .env and fill in. Used by docker-compose.yml.

# The public hostname Traefik should route to Chordall (must have DNS + a
# Cloudflare/Traefik cert set up in your Saltbox stack).
CHORDALL_HOST=chordall.yourdomain.com

# Claude API key — enables the AI setlist-by-mood and the era/theme browse
# categories. Leave blank to run without them (they show an "add your key" note).
ANTHROPIC_API_KEY=

# Optional: use a cheaper model for AI features (default: claude-opus-5).
# Any current Claude model works — the app adapts its request to the model
# (e.g. Haiku 4.5 doesn't take the `effort` parameter, so it isn't sent).
# CHORDALL_AI_MODEL=claude-haiku-4-5
